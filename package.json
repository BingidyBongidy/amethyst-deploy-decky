  "author": "Brad",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "8.18.2",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0"
  },
  "pnpm": {
    "peerDependencyRules": {
