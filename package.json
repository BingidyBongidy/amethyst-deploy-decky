{
  "name": "amethyst-deploy",
  "version": "0.1.0",
  "description": "Decky plugin: deploy Amethyst Mod Manager profiles from Gaming Mode",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "vitest run",
    "lint": "eslint src"
